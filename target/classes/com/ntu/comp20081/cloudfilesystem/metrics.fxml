<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: #1a2634; -fx-padding: 30;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ntu.comp20081.cloudfilesystem.MetricsController">
    <children>
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Infrastructure Analytics" />
        <Separator opacity="0.2" />
        
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <children>
                <BarChart fx:id="storageChart" style="-fx-text-fill: white;" title="Node Storage Usage (MBs)" HBox.hgrow="ALWAYS">
                    <xAxis><CategoryAxis label="Storage Node" tickLabelFill="WHITE" /></xAxis>
                    <yAxis><NumberAxis label="Usage (MB)" tickLabelFill="WHITE" /></yAxis>
                </BarChart>
            </children>
        </HBox>

        <Label text="Active Node Registry Status:" textFill="#bdc3c7" style="-fx-font-size: 14px;" />
        
        <ScrollPane fitToWidth="true" prefHeight="150.0" style="-fx-background: #2c3e50; -fx-background-color: #2c3e50; -fx-padding: 10; -fx-background-radius: 10;">
            <content>
                <VBox fx:id="statusContainer" spacing="10" style="-fx-background-color: #2c3e50;" />
            </content>
        </ScrollPane>
        
        <Button maxWidth="Infinity" onAction="#refreshData" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Synchronize Metrics" />
    </children>
</VBox>