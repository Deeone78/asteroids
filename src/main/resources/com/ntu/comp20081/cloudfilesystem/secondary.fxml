<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ntu.comp20081.cloudfilesystem.SecondaryController">
   <left>
      <VBox prefWidth="250.0" spacing="12.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">
         <padding><Insets bottom="30.0" left="20.0" right="20.0" top="35.0" /></padding>
         <children>
            <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #333333;" text="LB Cloud System" />
            <Separator opacity="0.5" prefHeight="10" />
            
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#loadFileList" text="File Explorer" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleOpenTerminal" text="System Console" />
            
            <VBox fx:id="adminContainer" managed="false" spacing="10" visible="false">
               <children>
                  <Separator opacity="0.5" />
                  <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="ADMIN TOOLS" textFill="#6c757d" />
                  <Button fx:id="btnRemoveUser" maxWidth="Infinity" onAction="#handleDeleteUser" text="Remove User" />
                  <Button fx:id="btnManageAccess" maxWidth="Infinity" onAction="#handleManageAccess" text="Manage Access" />
                  <Button fx:id="btnMetrics" maxWidth="Infinity" onAction="#handleOpenMetrics" text="System Metrics" />
               </children>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-base: #e9ecef;" text="Log Out" />
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="20" style="-fx-padding: 30;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20">
               <children>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Dashboard" />
                        <HBox alignment="CENTER_LEFT" spacing="8">
                           <children>
                              <Circle fx:id="statusCircle1" fill="#28a745" radius="5.0" />
                              <Label fx:id="statusLabel1" text="Nodes Online" textFill="#6c757d" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Button onAction="#handleUpload" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 8 15;" text="Upload File" />
               </children>
            </HBox>

            <TabPane fx:id="mainTabPane" style="-fx-background-color: white; -fx-border-color: #dee2e6;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>
                  <Tab text="Files">
                    <content>
                      <TableView fx:id="fileTable">
                         <columns>
                            <TableColumn fx:id="nameColumn" prefWidth="250.0" text="Filename" />
                            <TableColumn fx:id="sizeColumn" prefWidth="120.0" text="Size" />
                            <TableColumn fx:id="dateColumn" prefWidth="180.0" text="Date Modified" />
                            <TableColumn fx:id="colAccess" prefWidth="120.0" text="Access Rights" />
                         </columns>
                      </TableView>
                    </content>
                  </Tab>
                  <Tab fx:id="nodeRegistryTab" text="Registry">
                    <content>
                      <TableView fx:id="userTable">
                         <columns>
                            <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                            <TableColumn fx:id="colUsername" prefWidth="200.0" text="Username" />
                            <TableColumn fx:id="colRole" prefWidth="150.0" text="Role" />
                         </columns>
                      </TableView>
                    </content>
                  </Tab>
                </tabs>
              </TabPane>

            <VBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <children>
                        <ProgressIndicator fx:id="activeOperationIndicator" prefHeight="18.0" prefWidth="18.0" visible="false" />
                        <Label fx:id="progressStatusLabel" style="-fx-font-weight: bold;" text="System Status: Idle" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="delayTimerLabel" text="Ready" textFill="#6c757d" />
                     </children>
                  </HBox>
                  <ProgressBar fx:id="operationProgressBar" maxWidth="Infinity" prefHeight="10.0" progress="0.0" />
               </children>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="12">
               <children>
                  <Button onAction="#handleShareFile" prefWidth="100" text="Share" />
                  <Button onAction="#handleDeleteFile" prefWidth="100" style="-fx-text-fill: #dc3545;" text="Delete" />
                  <Button onAction="#handleDownload" prefWidth="120" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Download" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
